		"styles": [
			{
				"name": "blue-header-alternate-rows",
				"content": "self {\n  border-radius: 10px;\n  box-shadow: 0 0 40px 0 rgb(0 0 0 / 15%);\n}\n\nself .header .header-cell {\n  background-color: #6c7ae0;\n  color: #fff;\n  font-weight: bold;\n  padding: 1.25rem 2rem;\n}\n\nself .row {\n  align-items: center;\n}\n\nself .row .cell {\n  padding: 0.5rem 2rem;\n}\n\nself .row .cell > span {\n  justify-content: flex-start;\n}\n\nself .row.selected {\n  background-color: #d2d7f5;\n}\n\nself .row-even:not(.selected):not(:hover) {\n  background-color: #f8f6ff;\n}\n\nself .header .resizable > :not([hidden]) ~ :not([hidden]),\nself .row > :not([hidden]) ~ :not([hidden]),\nself .Grid .innerScrollContainer,\nself .Grid .innerScrollContainer > :not([hidden]) ~ :not([hidden]) {\n  border-width: 0;\n}",
				"parentId": null,
				"id": "PL652ycE3f6pTdyAeRfgp",
				"scope": "local"
			},
			{
				"name": "test",
				"content": "self {\nbackground-color: red !important;\n}",
				"parentId": null,
				"id": "KiF1iNkAUJ49blYA6xsjM",
				"scope": "local"
			},
			{
				"name": "inventory-container",
				"content": ".inventory-container {\n    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);\n    min-height: 100vh;\n    padding: 20px;\n}",
				"parentId": null,
				"id": "63y-TLZb68DLqxAHQjwVI",
				"scope": "local"
			},
			{
				"name": "header-container",
				"content": ".header-container {\n    display: flex;\n    justify-content: space-between;\n    align-items: center;\n    margin-bottom: 30px;\n}",
				"parentId": null,
				"id": "ZCNwMu0DpBYH2ORrseEL6",
				"scope": "local"
			},
			{
				"name": "main-title",
				"content": ".main-title {\n    color: white;\n    font-size: 28px;\n    font-weight: 600;\n}",
				"parentId": null,
				"id": "WKXSeXn8_esQfPMi4pJ9A",
				"scope": "local"
			},
			{
				"name": "add-stock-btn",
				"content": ".add-stock-btn {\n    background: #10b981 !important;\n    color: white !important;\n    padding: 12px 24px !important;\n    border: none !important;\n    border-radius: 8px !important;\n    font-weight: 500 !important;\n    font-size: 14px !important;\n}",
				"parentId": null,
				"id": "K-xhQxl9Z2KZMTgfxVj9k",
				"scope": "local"
			},
			{
				"name": "stats-container",
				"content": ".stats-container {\n    display: grid;\n    grid-template-columns: repeat(4, 1fr);\n    gap: 20px;\n    margin-bottom: 30px;\n    width: 100%;\n}",
				"parentId": null,
				"id": "hD1Ho6xWVVrFFwye52hMF",
				"scope": "local"
			},
			{
				"name": "stat-card",
				"content": ".stat-card {\n\tbackground: white !important;\n\tpadding: 24px !important;\n\tborder-radius: 12px !important;\n\tbox-shadow: 0 4px 6px rgba(0, 0, 0, 0.1) !important;\n\ttransition: transform 0.3s ease, box-shadow 0.3s ease !important; \n\tborder: none !important;\n  }\n  \n  .stat-card:hover {\n\ttransform: translateY(-5px) scale(1.02); \n\tbox-shadow: 0 10px 15px rgba(0, 0, 0, 0.2) !important; \n  }",
				"parentId": null,
				"id": "PEbG1C1RV_WJxDCXhSYjf",
				"scope": "local"
			},
			{
				"name": "stat-title",
				"content": ".stat-title {\n    color: #6b7280 !important;\n    font-size: 12px !important;\n    font-weight: 500 !important;\n    text-transform: uppercase !important;\n    letter-spacing: 0.5px !important;\n    margin-bottom: 8px !important;\n    margin-top: 0 !important;\n    line-height: 1.2 !important;\n}",
				"parentId": null,
				"id": "nXtQ4IpuoA8iAoKAecoCV",
				"scope": "local"
			},
			{
				"name": "stat-number",
				"content": ".stat-number {\n    font-size: 32px !important;\n    font-weight: 700 !important;\n    color: #1f2937 !important;\n    margin: 0 !important;\n    line-height: 1 !important;\n}",
				"parentId": null,
				"id": "mJY8wW8JQbHRTBvfszPV9",
				"scope": "local"
			},
			{
				"name": "no-border-input",
				"content": ".no-border-input {\n  border: none;\n  background-color: transparent; \n}",
				"parentId": null,
				"scope": "local",
				"id": "NH-G_JxZKUauT3BHrAgNU"
			},
			{
				"name": "kpi-value",
				"content": ".kpi-value {\n    color: #3158e0; \n    font-size: 3rem; \n    font-weight: 700; \n  }",
				"parentId": null,
				"scope": "local",
				"id": "QoNfrmElMgczQqKeqC-kE"
			},
			{
				"name": "styled-table",
				"content": ".styled-table {\n\tbackground-color: #ffffff;\n\tborder-radius: 8px;\n\tbox-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);\n\tcolor: #333333;\n  }\n  \n  .styled-table thead th {\n\tbackground-color: #ffffff;\n\tcolor: #4c3d8f;\n\tfont-weight: 600;\n\tpadding: 12px 15px;\n\tborder-bottom: 2px solid #e2e8f0;\n  }\n  \n  .styled-table tbody td {\n\tpadding: 12px 15px;\n\tborder-bottom: 1px solid #e2e8f0;\n  }\n  \n  .styled-table tbody tr:last-child td {\n\tborder-bottom: none;\n  }",
				"parentId": null,
				"scope": "local",
				"id": "EsCKomrnTWuKiB6b4l3px"
			},
			{
				"name": "inventory-header",
				"content": ".inventory-header {\n  background-color: #8e9ee7;\n  border-radius: 8px;\n  padding: 15px 20px;\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n}",
				"parentId": null,
				"scope": "local",
				"id": "PcxL8lo9v3-7lLtjFyAhR"
			},
			{
				"name": "update-btn",
				"content": ".update-btn {\n  background: linear-gradient(to right, #6a40a8, #8c60ce);\n  color: #ffffff;\n  border-radius: 9999px !important;\n  padding: 10px 24px !important;\n  font-weight: 600;\n  border: none;\n  cursor: pointer;\n  box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);\n  transition: transform 0.2s ease-in-out;\n}\n\n.update-btn:hover {\n  transform: scale(1.05);\n}",
				"parentId": null,
				"scope": "local",
				"id": "FR-pGfmnxiwK1k3q0Y51B"
			},
			{
				"name": "delete-btn",
				"content": ".delete-btn {\n  background: linear-gradient(to right, #d9534f, #c9302c); \n  color: #ffffff;\n  border-radius: 9999px !important; \n  padding: 10px 24px !important;\n  font-weight: 600;\n  border: none;\n  cursor: pointer;\n  box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);\n  transition: transform 0.2s ease-in-out;\n}\n\n.delete-btn:hover {\n  transform: scale(1.05); }",
				"parentId": null,
				"scope": "local",
				"id": "xvDOq12jm2r97w_JWAOYF"
			}
		]
