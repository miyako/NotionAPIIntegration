<?xml version="1.0" encoding="UTF-8"?>
<xliff xmlns="urn:oasis:names:tc:xliff:document:1.2" version="1.2">
	<file datatype="plaintext" original="messagesJA.xlf" source-language="en" target-language="ja">
		<body>
			<trans-unit id="Startup_AlertCredentials" resname="Startup_AlertCredentials">
				<source>Please enter your Notion API credentials.</source>
				<target>Notion APIの認証情報を入力してください。</target>
			</trans-unit>
			<trans-unit id="Startup_RequestBearerToken" resname="Startup_RequestBearerToken">
				<source>Enter Notion Bearer Token:</source>
				<target>Notionのインテグレーションシークレットを入力してください：</target>
			</trans-unit>
			<trans-unit id="Startup_RequestDatabaseId" resname="Startup_RequestDatabaseId">
				<source>Enter Notion Database ID:</source>
				<target>NotionのデータベースIDを入力してください：</target>
			</trans-unit>
			<trans-unit id="Alert_ProductNameRequired" resname="Alert_ProductNameRequired">
				<source>Product Name is required!</source>
				<target>商品名を入力してください。</target>
			</trans-unit>
			<trans-unit id="Alert_ItemAdded" resname="Alert_ItemAdded">
				<source>Item '{name}' added successfully!</source>
				<target>「{name}」を追加しました。</target>
			</trans-unit>
			<trans-unit id="Alert_ErrorAddingItem" resname="Alert_ErrorAddingItem">
				<source>Error adding item: {status} - {message}</source>
				<target>アイテムの追加中にエラーが発生しました：{status} - {message}</target>
			</trans-unit>
			<trans-unit id="Alert_SelectProductToDelete" resname="Alert_SelectProductToDelete">
				<source>Please select a product from the list to delete.</source>
				<target>削除する商品をリストから選択してください。</target>
			</trans-unit>
			<trans-unit id="Request_ConfirmDelete" resname="Request_ConfirmDelete">
				<source>Type 'DELETE' to confirm deletion of {name}:</source>
				<target>「{name}」を削除するには「DELETE」と入力してください：</target>
			</trans-unit>
			<trans-unit id="Alert_DeletionCancelled" resname="Alert_DeletionCancelled">
				<source>Deletion cancelled.</source>
				<target>削除をキャンセルしました。</target>
			</trans-unit>
			<trans-unit id="Alert_ProductDeleted" resname="Alert_ProductDeleted">
				<source>Product {name} deleted successfully!</source>
				<target>「{name}」を削除しました。</target>
			</trans-unit>
			<trans-unit id="Alert_ErrorDeletingProduct" resname="Alert_ErrorDeletingProduct">
				<source>Error deleting product: {status} - {message}</source>
				<target>商品の削除中にエラーが発生しました：{status} - {message}</target>
			</trans-unit>
			<trans-unit id="Alert_SelectProductToUpdate" resname="Alert_SelectProductToUpdate">
				<source>Please select a product from the list to update its stock.</source>
				<target>在庫を更新する商品をリストから選択してください。</target>
			</trans-unit>
			<trans-unit id="Alert_StockUpdated" resname="Alert_StockUpdated">
				<source>Stock level for {name} updated successfully!</source>
				<target>「{name}」の在庫数を更新しました。</target>
			</trans-unit>
			<trans-unit id="Alert_ErrorUpdatingStock" resname="Alert_ErrorUpdatingStock">
				<source>Error updating stock: {status} - {message}</source>
				<target>在庫の更新中にエラーが発生しました：{status} - {message}</target>
			</trans-unit>
			<trans-unit id="Alert_ErrorQueryingDatabase" resname="Alert_ErrorQueryingDatabase">
				<source>Error querying database: {status} - {message}</source>
				<target>データベースのクエリ中にエラーが発生しました：{status} - {message}</target>
			</trans-unit>
			<trans-unit id="MenuItemInventory" resname="MenuItemInventory">
				<source>Inventory Manager</source>
				<target>在庫管理</target>
			</trans-unit>
		</body>
	</file>
</xliff>
